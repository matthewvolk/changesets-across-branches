{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    { "repo": "matthewvolk/changesets-across-branches" }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "restricted",
  "privatePackages": {
    "version": true,
    "tag": true
  },
  "baseBranch": "integration",
  "updateInternalDependencies": "patch",
  "ignore": [
    "web",
    "docs",
    "@repo/ui",
    "@repo/eslint-config",
    "@repo/typescript-config"
  ]
}
